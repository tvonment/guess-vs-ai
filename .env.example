# Local Development Environment Configuration
# Copy this file to .env.local and fill in your actual values
# This file should be kept private and not committed to version control

# Environment Configuration
ENVIRONMENT=LOCAL

# OpenAI API Configuration
AZURE_AI_FOUNDRY_API_KEY=your_azure_ai_foundry_api_key_here
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_AI_FOUNDRY_VERIFICATION_MODEL=openai/deployments/gpt-4o/chat/completions?api-version=2025-01-01-preview

# Azure Cosmos DB Configuration
COSMOS_DB_CONNECTION_STRING=your_cosmos_db_connection_string_here
COSMOS_DB_DATABASE_NAME=your_database_name_here
COSMOS_DB_CONTAINER_NAME=your_container_name_here
